{
  "routes": [
    {
      "route": "/raw/*",
      "headers": {
        "content-type": "text/html; charset=utf-8"
      }
    },
    {
      "route": "/agent-best-practices.md",
      "headers": {
        "content-type": "text/markdown; charset=utf-8",
        "content-disposition": "attachment; filename=agent-best-practices.md"
      }
    }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}
